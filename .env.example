# Coolify website runtime. The browser connects directly to Supabase.
# start-preview.ps1 already supplies --demo. No .env is needed for preview.
PICC_DEMO=0
PICC_DATABASE=instance/picc-demo.sqlite3
PORT=8765
# Only public publishable/anon values. Never use a service_role key.
# LINE Login (optional) and Messaging API. Keep all secret values server-side.
# The webhook endpoint is https://<your-domain>/api/line/webhook
LINE_LOGIN_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Set these on the Coolify website application, with runtime access:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
