# Python is the isolated local preview only. Production uses dist/ + Supabase.
# start-preview.ps1 already supplies --demo. No .env is needed for preview.
PICC_DEMO=1
PICC_DATABASE=instance/picc-demo.sqlite3
PORT=8765
# Supabase frontend settings belong in static/config.js, then npm run build:client.
# Only publishable/anon key is allowed there. Never use a service_role key.
# LINE login and notifications are not configured in this phase.
